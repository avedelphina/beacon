# Copy to .env and fill in to enable login. Unset (or .env missing
# entirely), Beacon runs open — no auth, matching pre-auth local dev.

# docker-compose.yml binds beacon/mcp to 127.0.0.1 by default. Set this to
# 0.0.0.0 (or a specific interface) to expose them beyond this machine —
# only do that once ZITADEL_ISSUER/ZITADEL_CLIENT_ID are actually set below.
BEACON_BIND_HOST=127.0.0.1

# Zitadel instance and the Web application's client ID (PKCE, no secret —
# it's a public client, this ID isn't sensitive).
ZITADEL_ISSUER=https://id.example.com
ZITADEL_CLIENT_ID=

# Comma-separated exact email allowlist for OIDC users. Required when OIDC
# auth is enabled; login is denied for every other verified email.
BEACON_ALLOWED_EMAILS=tom@example.com

# Signs the session cookie. Required once the two above are set. Generate
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BEACON_SESSION_SECRET=

# Static bearer token the MCP server (port 8643) requires — not OIDC, MCP
# clients are configured with a fixed API key, not walked through a browser
# login. Unset, MCP runs open, same convention as the two above. Generate
# the same way as BEACON_SESSION_SECRET.
BEACON_MCP_TOKEN=
