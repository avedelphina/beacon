# Copy to .env and fill in to enable login. Unset (or .env missing
# entirely), Beacon runs open — no auth, matching pre-auth local dev.

# docker-compose.yml binds beacon/mcp to 127.0.0.1 by default. Set this to
# 0.0.0.0 (or a specific interface) to expose them beyond this machine —
# only do that once ZITADEL_ISSUER/ZITADEL_CLIENT_ID are actually set below.
BEACON_BIND_HOST=127.0.0.1

# Zitadel instance and the Web application's client ID (PKCE, no secret —
# it's a public client, this ID isn't sensitive).
ZITADEL_ISSUER=https://id.example.com
ZITADEL_CLIENT_ID=

# Comma-separated exact email allowlist for OIDC users. Required when OIDC
# auth is enabled; login is denied for every other verified email.
BEACON_ALLOWED_EMAILS=tom@example.com

# Signs the session cookie. Required once the two above are set. Generate
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BEACON_SESSION_SECRET=

# Set BEACON_SESSION_HTTPS_ONLY=false only for local HTTP development.
BEACON_SESSION_HTTPS_ONLY=true

# Static-key SSH uses this pre-provisioned file and fails closed if a host key
# is absent or changes. Generate/review it out of band; Beacon never learns new
# keys automatically. Teleport config_file hosts use tbot's own known_hosts.
BEACON_KNOWN_HOSTS=/etc/beacon/known_hosts

# Static bearer token the MCP server (port 8643) requires — not OIDC, MCP
# clients are configured with a fixed API key, not walked through a browser
# login. Unset, MCP runs open, same convention as the two above. Generate
# the same way as BEACON_SESSION_SECRET.
BEACON_MCP_TOKEN=

# Agent bus / A2A mesh. Every A2A token (Beacon->agent, agent->agent) is
# derived from this one secret, so nothing per agent is stored. Generate
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it rotates every token; run `python -m backend.mesh install`
# for every agent again.
BEACON_A2A_SECRET=

# Where agents' hosts reach Beacon to pull their mesh config (GET /mesh/*).
# BEACON_MESH_BIND adds a port binding (address:port, e.g. a tailnet IP);
# BEACON_PUBLIC_URL is the URL their sync calls. Set OIDC up first: the
# binding serves the whole app, not only /mesh.
# BEACON_MESH_BIND=100.64.0.1:8642
# BEACON_PUBLIC_URL=http://100.64.0.1:8642

# Operational store (mailbox, ...). Default: state/ next to fleet/.
# BEACON_STATE_DIR=/var/lib/beacon/state
