# A config template — merged under an agent's own `desired` for every agent
# that lists it in `templates:`. Copy to <name>.yaml, edit, then either add
# `templates: [<name>]` to an agent file or POST /api/templates/<name>/apply.
#
# Only `config` and `env_keys` are allowed here (same shape as those keys
# inside an agent's `desired`). install_mode / os_user / service / log_path
# stay per-agent on purpose.
#
# Merge rules: dicts deep-merge, everything else (scalars, lists) is
# replaced. An agent's own `desired` always wins over the template.
#
# Key paths below follow the REAL Hermes config schema (verified against
# hermes-agent v2026.9.7+ — see backend/drivers/hermes_config_schema.yaml,
# regenerated by scripts/dump_hermes_config_schema.py). Beacon refuses to
# push a path that isn't in that schema, so a typo here fails at push time,
# not silently on the host.

config:
  model:
    default: claude-sonnet-4-5       # bare model id, routed through model.provider
    provider: anthropic
    # base_url: https://...          # only for a custom endpoint; omit for the provider default
    aliases:                         # free-form: role name -> provider/model route
      fast: openrouter/google/gemini-2.5-flash
      smart: anthropic/claude-sonnet-4-5

  # Ordered fallback chain, tried in order when the primary route errors.
  # Pushed as ONE structured value (JSON list) — a list in an agent's own
  # desired replaces this wholesale, per the merge rules above.
  fallback_providers:
    - provider: openrouter
      model: anthropic/claude-sonnet-4
      base_url: https://openrouter.ai/api/v1
      key_env: OPENROUTER_API_KEY
      api_mode: chat_completions
    - provider: openrouter
      model: deepseek/deepseek-chat
      base_url: https://openrouter.ai/api/v1
      key_env: OPENROUTER_API_KEY
      api_mode: chat_completions

  auxiliary:                         # per-task helper models
    compression:                     # context compaction / summarization
      provider: openrouter
      model: google/gemini-2.5-flash
    vision:
      provider: openrouter
      model: google/gemini-2.5-flash

env_keys:
  - ANTHROPIC_API_KEY
  - OPENROUTER_API_KEY
