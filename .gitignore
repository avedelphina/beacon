.venv/
__pycache__/
*.pyc
.pytest_cache/

# tbot's own identity/certs — private key material, never committed
tbot/data/
tbot/storage/
tbot/tbot.log

# real fleet inventory — this repo is public, your actual hosts/agents
# aren't. See fleet/hosts.yaml.example for the schema.
fleet/hosts.yaml
fleet/agents/*.yaml
fleet/decommissioned/

# real Zitadel config + session secret — see .env.example
.env
